      <button type="button" class="step" data-go="sec-monitor" id="st-monitor"><span class="ic emo" aria-hidden="true">💓</span><span style="min-width:0"><b>2 MONITOR</b><small>ระหว่างฟอก</small></span></button>
      <button type="button" class="step" data-go="sec-eval" id="st-eval"><span class="ic emo" aria-hidden="true">🌟</span><span style="min-width:0"><b>3 EVALUATE</b><small>หลังคืนเลือด</small></span></button>
    </div>

    <form id="crf" novalidate>
      <!-- SCREEN -->
      <section class="card" id="sec-screen">
        <div class="card-h"><span class="ic emo" aria-hidden="true">🩺</span><div><span class="tag">Step 1 · Screen</span><h2>ก่อนเริ่มฟอกเลือด</h2><p>ข้อมูลทั่วไปและปัจจัยเสี่ยง (ส่วนที่ 1–2)</p></div></div>
        <div class="grid">
          <div class="field"><span class="lbl">ที่ฟอก *</span><div class="seg" data-name="locType"></div></div>
          <div class="field"><span class="lbl">รอบการฟอก<span class="new auto" id="shiftAuto" hidden>เลือกจากเวลาเริ่ม</span></span><div class="seg" data-name="shift"></div><span class="hint">รอบ 3 = เคสที่เริ่ม HD ตั้งแต่ 15:30 น. เป็นต้นไป</span></div>
          <div class="field wide" id="bedWrap"><span class="lbl">เตียง (หน่วยไตเทียม) *</span><div class="bedgrid" id="bedGrid"></div></div>
          <div class="field" id="slotWrap" hidden><span class="lbl">ลำดับ Portable *</span><div class="seg" data-name="slot"></div></div>
          <div class="field" id="pwardWrap" hidden><label for="f-pward">หอผู้ป่วย/ICU ที่ไปฟอก</label><input type="text" id="f-pward" name="pward" autocomplete="off"></div>
          <div class="field"><label for="f-date"><span class="q">1</span>วันที่ฟอกเลือด *</label><input type="date" id="f-date" name="date"></div>
          <div class="field wide" id="pidField"><label for="f-hn"><span class="q">2</span>ผู้ป่วย: พิมพ์ HN แล้วกดแปลงเป็นรหัสวิจัย *</label>
            <div class="pidrow" id="hnRow"><input type="text" id="f-hn" inputmode="numeric" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="20" placeholder="HN"><button type="button" class="btn primary" id="hnBtn">🔐 แปลงรหัส</button></div>
            <span class="msg" id="hnMsg"></span>
            <div class="pidshow" id="pidShow" hidden><span class="pidtag">รหัสวิจัย <b id="pidCode"></b></span><span class="pidnote" id="pidNote"></span><button type="button" class="linkbtn" id="pidChange">เปลี่ยนผู้ป่วย</button></div>
            <input type="text" name="pid" id="f-pid" hidden tabindex="-1"><input type="text" name="pinit" id="f-pinit" hidden tabindex="-1">
            <div class="hist" id="ptHist" hidden></div>
            <span class="hint">🔒 HN ใช้ค้นหารหัสเท่านั้น ไม่ถูกบันทึกในแอพหรือในชีต · ผู้ป่วยใหม่ได้เลขรันถัดไปอัตโนมัติ</span></div>
          <div class="field"><label for="f-age"><span class="q">3</span>อายุ (ปี)</label><input type="number" id="f-age" name="age" min="18" max="110" inputmode="numeric"></div>
          <div class="field"><span class="lbl"><span class="q">4</span>เพศ</span><div class="seg" data-name="sex"></div></div>
          <div class="field"><span class="lbl"><span class="q">5</span>หน่วยที่ส่งมา</span><div class="seg" data-name="ward"></div></div>
          <div class="field"><span class="lbl">🫘 Dx ภาวะไต *<span class="new">ใหม่</span></span><div class="seg" data-name="renalDx"></div></div>
          <div class="field wide"><span class="lbl">📋 Dx โรคทั้งหมด<span class="new">ใหม่</span> <span class="dxcount" id="dxCount"></span></span>
            <div class="dxwrap"><input type="search" id="dxSearch" placeholder="🔎 พิมพ์ค้นหา Dx เช่น sep, crbsi, chf, lepto" autocomplete="off" autocapitalize="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="dxSug">
              <div class="dxsug" id="dxSug" role="listbox" hidden></div></div>
            <div class="dxsel" id="dxSel"></div>
            <input type="text" id="dxOther" hidden tabindex="-1">
            <input type="text" name="dxText" id="f-dx" hidden tabindex="-1"><input type="text" name="dxGroups" id="f-dxg" hidden tabindex="-1">
          </div>
          <div class="field"><span class="lbl"><span class="q">6</span>ใส่ ETT ขณะฟอก<span class="new">ใหม่</span></span><div class="seg" data-name="ett"></div></div>
        </div>
        <div class="sub"><span class="hico emo" aria-hidden="true">🛡️</span>ปัจจัยก่อนเริ่มฟอก</div>
        <div class="grid">
          <div class="field wide"><span class="lbl"><span class="q">7</span>เคยอุดตัน (Grade ≥ 2) ในการฟอกครั้งก่อน<span class="new">ใหม่</span><span class="new auto" id="prevAuto" hidden>เติมจากประวัติ</span></span><div class="seg" data-name="prevClot"></div></div>
          <div class="field"><label for="f-hct"><span class="q">8</span>Hct ภายใน 48 ชม. (%)<span class="new">ใหม่</span></label><input type="number" id="f-hct" name="hct" step="0.1" min="5" max="70" inputmode="decimal"></div>
          <div class="field"><label for="f-plt"><span class="q">9</span>เกล็ดเลือด 48 ชม. (×10³/µL)<span class="new">ใหม่</span></label><input type="number" id="f-plt" name="plt" min="1" max="1500" inputmode="numeric"></div>
          <div class="field"><span class="lbl"><span class="q">10</span>Vascular access</span><div class="seg" data-name="access"></div></div>
          <div class="field"><span class="lbl"><span class="q">11</span>ตำแหน่ง catheter</span><div class="seg" data-name="cathSite"></div></div>
          <div class="field"><span class="lbl">เครื่องไตเทียม</span><div class="seg" data-name="machine"></div></div>
          <div class="field"><span class="lbl"><span class="q">12</span>ยาต้านการแข็งตัวของเลือด</span><div class="seg" data-name="anticoag"></div></div>
          <div class="field" id="heparinWrap"><label for="f-hepU">ขนาด heparin รวม (unit)</label><input type="number" id="f-hepU" name="heparinU" min="0" inputmode="numeric"></div>
          <div class="field"><label for="f-rxh"><span class="q">13</span>เวลาฟอกที่สั่ง (ชม.)</label><input type="number" id="f-rxh" name="rxHours" step="0.5" min="0.5" max="12" inputmode="decimal"></div>
          <div class="field"><label for="f-uf"><span class="q">14</span>UF goal (mL)</label><input type="number" id="f-uf" name="ufGoal" min="0" max="8000" inputmode="numeric"></div>
          <div class="field"><label for="f-bfrset"><span class="q">15</span>แผน BFR (mL/min)</label><input type="number" id="f-bfrset" name="bfrSet" min="50" max="500" inputmode="numeric"><span class="hint">ใช้คำนวณเกณฑ์ BFR/2 ± 50 และ BFR ลดลง 10%</span></div>
        </div>
        <div class="risk" id="riskBox" hidden><b>ปัจจัยที่ควรเฝ้าระวังเป็นพิเศษ</b><div class="chips" id="riskChips"></div></div>
      </section>

      <!-- MONITOR -->
      <section class="card" id="sec-monitor">
        <div class="card-h"><span class="ic emo" aria-hidden="true">💓</span><div><span class="tag">Step 2 · Monitor → Trigger → Act</span><h2>ระหว่างฟอกเลือด</h2><p>ประเมินอย่างน้อยทุก 30 นาที และเมื่อมีสัญญาณเตือน <span id="alertNote"></span></p></div></div>
        <div class="now" id="nowCard" hidden><span class="lamp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9"/></svg></span><div><div class="big" id="nowBig"></div><div class="sm" id="nowSm"></div></div></div>
        <div class="startcard" id="startCard">
          <label for="f-start" class="sc-l"><span aria-hidden="true">⏰</span> เวลาเริ่ม HD *</label>
          <div class="sc-row"><input type="time" id="f-start" name="startTime"><button type="button" class="btn" id="startNow">▶️ เริ่มตอนนี้</button></div>
          <span class="hint" id="startHint">ลงเวลาเริ่มก่อน แล้วกด “➕ เพิ่มจุดเวลา” ทุกรอบที่ประเมิน แอพจะบอกว่า HD มาแล้วกี่ ชม. กี่นาที</span>
        </div>
        <details class="ref"><summary>ดูเกณฑ์ 4 สี (Checklist ส่วนที่ 4)</summary>
          <div class="reftbl"><table>
            <thead><tr><th style="background:none;color:var(--muted)"></th><th class="c0">สีเขียว (ปกติ)</th><th class="c1">สีเหลือง (เฝ้าระวัง)</th><th class="c2">สีส้ม (เฝ้าระวังใกล้ชิด)</th><th class="c3">สีแดง (คืนเลือด)</th></tr></thead>
            <tbody>
              <tr><td>VP (mmHg)</td><td>BFR/2 ± 50 ไม่เปลี่ยนแปลง</td><td>&gt; 150–180</td><td>&gt; 180–210</td><td>&gt; 210–240</td></tr>
              <tr><td>TMP เพิ่มขึ้น (mmHg)</td><td>&lt; 40</td><td>&gt; 40–80</td><td>&gt; 80–120</td><td>&gt; 120–160</td></tr>
              <tr><td>Clot grade</td><td>0 (ไม่มี fibrin/clot)</td><td>1 (มี fibrin บางส่วน)</td><td>2 (มี fibrin/clot ชัดเจน)</td><td>3 (มี clot มาก/อุดตัน)</td></tr>
              <tr><td>การดำเนินการ</td><td><b>ฟอกต่อ (Continue)</b><br>• เฝ้าระวังต่อเนื่อง<br>• บันทึกตามรอบ</td><td><b>แก้ไขตาม protocol และประเมินซ้ำ 5–10 นาที</b><br>• Flush NSS<br>• ประเมินค่าเครื่อง HD<br>• ประเมิน clot อีกครั้ง</td><td><b>แก้ไขด่วน และประเมินซ้ำ 5–10 นาที</b><br>• Flush ถี่ขึ้น<br>• เฝ้าระวังใกล้ชิดเพิ่มขึ้น<br>• ประเมินค่าเครื่อง HD และ clot</td><td><b>พบข้อใดข้อหนึ่ง คืนเลือด (Return Blood)</b><br>• หยุดการรักษาทันที<br>• ดำเนินการคืนเลือดตาม protocol<br>• เปลี่ยน Circuit</td></tr>
            </tbody>
          </table></div>
          <p class="note" style="margin-top:0">พบข้อใดข้อหนึ่งในแต่ละสี ให้ดำเนินการตามแผน แอพเลือกสีที่รุนแรงที่สุดให้อัตโนมัติ</p>
        </details>
        <div id="monRows" class="timeline"></div>
        <div class="empty-mon" id="monEmpty">ยังไม่มีจุดเวลา กด “➕ เพิ่มจุดเวลา” เมื่อฟอกครบ 15 นาที เพื่อบันทึกค่าตั้งต้น</div>
        <button class="addpt" type="button" id="addPoint">➕ เพิ่มจุดเวลา</button>
        <div id="trendWrap" class="trend" hidden>
          <div class="legend"><b class="disp">แนวโน้ม</b><span class="sw vp"></span>ΔVP <span class="sw tmp"></span>ΔTMP <span class="note" style="margin:0">mmHg เทียบจุดแรก</span></div>
          <svg id="trend" viewBox="0 0 600 180" role="img" aria-label="แนวโน้ม ΔVP และ ΔTMP ระหว่างฟอก"></svg>
        </div>
        <div class="sub"><span class="hico emo" aria-hidden="true">📈</span>สรุปค่าระหว่างฟอก</div>
        <div class="grid">
          <div class="field wide"><div class="autosum" id="autoSum">
            <div class="as-h">⏱️ แอพสรุปให้จากจุดเวลา ไม่ต้องกรอก</div>
            <div class="as-grid">
              <div><span class="q">16</span>BFR ต่ำสุด<b id="as-bfr">–</b><small>mL/min</small></div>
              <div><span class="q">18</span>VP สูงสุด<b id="as-vp">–</b><small>mmHg</small></div>
              <div>TMP สูงสุด<b id="as-tmp">–</b><small>mmHg</small></div>
              <div>ΔTMP สูงสุด<b id="as-dtmp">–</b><small>mmHg จากจุดแรก</small></div>
            </div></div>
            <input type="number" name="bfrMin" hidden tabindex="-1"><input type="number" name="vpMax" hidden tabindex="-1"><input type="number" name="tmpMax" hidden tabindex="-1"><input type="number" name="dtmpMax" hidden tabindex="-1">
          </div>
          <div class="field wide"><span class="lbl"><span class="q">17</span>ให้เลือด/เกล็ดเลือดผ่านวงจร<span class="new">ใหม่</span></span><div class="seg" data-name="transfusion"></div></div>
        </div>
      </section>

      <!-- EVALUATE -->
      <section class="card" id="sec-eval">
        <div class="card-h"><span class="ic emo" aria-hidden="true">🌟</span><div><span class="tag">Step 3 · Evaluate</span><h2>หลังคืนเลือด</h2><p>ประเมินตาม Visual Guide: Circuit Clotting Grade 0–3</p></div></div>
        <div class="field wide"><span class="lbl"><span class="q">19</span>Circuit Clotting Grade สูงสุดที่พบ *</span>
          <div class="gcards" id="gradeCards"></div>
        </div>
        <div class="sub"><span class="hico emo" aria-hidden="true">🔗</span>ผลกระทบต่อวงจร</div>
        <div class="grid">
          <div class="field"><span class="lbl"><span class="q">21</span>Circuit loss (สูญเสียวงจร/คืนเลือดไม่ได้) *</span><div class="seg" data-name="noReturn"></div></div>
          <div class="field"><span class="lbl"><span class="q">20</span>เปลี่ยน dialyzer ก่อนเวลา *</span><div class="seg" data-name="changed"></div></div>
          <div class="field"><span class="lbl">เปลี่ยน bloodline</span><div class="seg" data-name="changeLine"></div></div>
          <div class="field wide" id="changeReasonWrap"><label for="f-chreason">เหตุผลที่เปลี่ยน</label><input type="text" id="f-chreason" name="changeReason" autocomplete="off"></div>
          <div class="field wide startcard" id="endCard">
            <label for="f-end" class="sc-l"><span class="q">22</span>⏹️ เวลาเลิก HD (เริ่มคืนเลือด)</label>
            <div class="sc-row"><input type="time" id="f-end" name="endTime"><button type="button" class="btn" id="endNow">⏹️ เลิกตอนนี้</button></div>
            <div class="elapsed"><label class="ell" for="f-acth">ฟอกจริง</label><input type="number" id="f-acth" inputmode="numeric" min="0" max="12" placeholder="0"><span class="u">ชม.</span><input type="number" id="f-actm" inputmode="numeric" min="0" max="59" placeholder="0"><span class="u">นาที</span></div>
            <input type="number" name="actualMin" id="f-actual" hidden tabindex="-1">
            <span class="esrc" id="actSrc">ลงเวลาเลิก แอพคำนวณเวลาฟอกจริงให้ หรือกรอก ชม./นาที จากหน้าจอเครื่อง</span>
            <div class="cmp" id="actCmp" hidden></div>
          </div>
          <div class="field wide"><span class="lbl">ฟอกครบตามเวลาที่สั่งหรือไม่<span class="new auto" id="earlyAuto" hidden>คำนวณให้</span></span><div class="seg" data-name="earlyStop"></div></div>
          <div class="field wide" id="reasonWrap"><span class="lbl">สาเหตุที่ฟอกไม่ครบเวลา *</span><div class="seg" data-name="earlyReasonCode"></div>
            <input type="text" id="f-reason" name="earlyReason" autocomplete="off" placeholder="รายละเอียดเพิ่มเติม (ถ้ามี)"></div>
        </div>
        <div class="outcome" id="outcomeBox" hidden></div>
      </section>

      <div class="savebar" id="saveBar">
        <button class="btn primary" type="submit" id="saveBtn">💾 บันทึกข้อมูล</button>
        <button class="btn" type="button" id="resetBtn">🧹 ล้างฟอร์ม</button>
        <span class="msg" id="formMsg" role="status">บันทึกระหว่างฟอกได้เรื่อย ๆ</span>
      </div>
    </form>
  </div>

  <!-- LIST -->
  <div id="view-list" hidden>
    <div class="tools">
      <input type="text" id="search" placeholder="ค้นหารหัสหรืออักษรย่อ" autocomplete="off">
      <span class="note" style="margin:0">แตะรายการเพื่อเปิดต่อหรือแก้ไข</span>
    </div>
    <div class="rlist" id="rows"></div>
    <div class="empty" id="listEmpty">ยังไม่มีข้อมูล เริ่มบันทึกได้ที่แท็บ “บันทึก” รายการแต่ละครั้งที่ฟอกจะแสดงที่นี่</div>
  </div>

  <!-- SUMMARY -->
  <div id="view-sum" hidden>
    <div class="kpis">
      <div class="kpi hl"><div class="v" id="k-rate">–</div><div class="k">อุดตันต่อ 100 HD sessions</div></div>
      <div class="kpi"><div class="v" id="k-n">0</div><div class="k">sessions ที่ประเมินครบ</div></div>
      <div class="kpi"><div class="v" id="k-ev">0</div><div class="k">เกิดการอุดตัน</div></div>
      <div class="kpi"><div class="v" id="k-pt">0</div><div class="k">ผู้ป่วย (รหัสไม่ซ้ำ)</div></div>
      <div class="kpi"><div class="v" id="k-mon">–</div><div class="k">มีค่าตามเวลา ≥ 2 จุด</div></div>
      <div class="kpi"><div class="v" id="k-target">0%</div><div class="k">ความคืบหน้าสู่ 1,030 sessions</div><div class="prog"><i id="k-prog" style="width:0"></i></div></div>
    </div>
    <h3><span class="hico emo" aria-hidden="true">🍩</span>สัดส่วน Clot Grade</h3>
    <div class="gbar" id="gbar"></div>
    <div class="glegend" id="glegend"></div>
    <h3><span class="hico emo" aria-hidden="true">📊</span>อัตราการอุดตันแยกตามปัจจัย</h3>
    <div class="tablewrap"><table class="ft">
      <thead><tr><th>ปัจจัย</th><th>กลุ่ม</th><th class="num">n</th><th class="num">อุดตัน</th><th class="num">ต่อ 100</th></tr></thead>
      <tbody id="factorRows"></tbody>
    </table></div>
    <p class="note">นับเฉพาะ sessions ที่ประเมินครบแล้ว “อุดตัน” = Grade ≥ 2 หรือ circuit loss หรือเปลี่ยน dialyzer/bloodline ก่อนเวลา ตารางนี้ใช้ติดตามระหว่างเก็บข้อมูล (ยังไม่ปรับอิทธิพลตัวแปรอื่น)</p>
    <h3><span class="hico emo" aria-hidden="true">🔔</span>ตั้งค่าการเตือน</h3>
    <div class="setting"><label class="switch"><input type="checkbox" id="alertToggle"> เปิดการเตือน (สีใน Step 2 + ส่ง LINE)</label><input type="text" id="adminKey" placeholder="รหัสผู้ดูแล (ADMIN_KEY)" autocomplete="off" style="max-width:220px"><span class="msg" id="alertMsg"></span></div>
    <p class="note">ใช้กับทุกเครื่อง ต้องใส่รหัสผู้ดูแลจึงเปลี่ยนได้ ปิดในระยะที่ 1 (ใช้ checklist กระดาษ) และเปิดในระยะที่ 3</p>
    <h3><span class="hico emo" aria-hidden="true">📥</span>ส่งออกข้อมูล</h3>
    <div class="setting">
      <button class="btn" type="button" id="csvBtn">CSV ข้อมูลรายครั้ง</button>
      <button class="btn" type="button" id="csvMonBtn">CSV ค่าตามเวลา</button>
      <span class="msg" id="csvMsg"></span>
    </div>

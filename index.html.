function setMsg(e,t,ok){e.textContent=t;e.className="msg "+(ok?"ok":"bad")}
function validate(o){
  const miss=[];
  if(!o.date)miss.push("วันที่");
  if(!o.locType)miss.push("ที่ฟอก");
  if(o.locType==="unit"&&o.bed==null)miss.push("เตียง");
  if(o.locType==="portable"&&!o.slot)miss.push("ลำดับ Portable");
  if(!o.pid)miss.push("HN → รหัสวิจัย (กดแปลงรหัส)");
  if(!o.renalDx)miss.push("Dx ภาวะไต (AKI/ESRD)");
  if(o.grade!=null||o.changed!=null||o.noReturn!=null){
    if(o.grade==null)miss.push("Clot Grade");
    if(o.noReturn==null)miss.push("Circuit loss");
    if(o.changed==null)miss.push("เปลี่ยน dialyzer");
  }
  const pts=mon.filter(hasData);
  if(pts.length&&!o.startTime)miss.push("เวลาเริ่ม HD");
  if(o.earlyStop==="1"&&!o.earlyReasonCode)miss.push("สาเหตุที่ฟอกไม่ครบเวลา");
  if(o.earlyReasonCode==="other"&&!o.earlyReason)miss.push("รายละเอียดสาเหตุ (อื่น ๆ)");
  if(miss.length)return "กรอกให้ครบ: "+miss.join(", ");
  if(pts.some(p=>p.min==null))return "ใส่เวลาที่ HD มาแล้วให้ครบทุกจุดเวลา";
  if(pts.some(p=>p.min>720))return "มีจุดเวลาห่างจากเวลาเริ่ม HD เกิน 12 ชม. ตรวจสอบเวลาอีกครั้ง";
  if(o.pinit){const owner=records.find(r=>r.pid===o.pid&&r.id!==editingId&&r.pinit&&normInit(r.pinit)!==normInit(o.pinit));
    if(owner)return "รหัส "+o.pid+" เป็นของผู้ป่วย "+owner.pinit+" แล้ว กด “ผู้ป่วยใหม่” อีกครั้งเพื่อรับรหัสใหม่";}
  if(/^\d{6,}$/.test(o.pid))return "รหัสผู้ป่วยดูเหมือน HN กรุณาใช้รหัสวิจัยแทน";
  return null;
}
form.addEventListener("submit",async e=>{
  e.preventDefault();
  const msg=$("#formMsg");const o=readForm();
  const err=validate(o);if(err){setMsg(msg,err,false);return}
  if(!me){setMsg(msg,"ใส่ชื่อผู้บันทึกที่มุมบนก่อน (เครื่องจะจำไว้)",false);$("#meSel").focus();return}

  o.status=hasOutcome(o)?"complete":"ongoing";
  o.clot=isClot(o)?1:0;
  const lastP=o.monitor.filter(p=>p.min!=null).sort((a,b)=>a.min-b.min).pop()||null;
  o.lastMin=lastP?lastP.min:null;o.lastLevel=lastP?lastP.level:null;
  o.nextDueAt=null;
  if(o.status==="ongoing"&&lastP?.level!==3){
    const step=lastP?((lastP.level===1||lastP.level===2)?10:30):15;
    const nextMin=lastP?lastP.min+step:15;
    if(o.startTime&&o.date){const t=new Date(o.date+"T"+o.startTime+":00");if(!isNaN(t))o.nextDueAt=new Date(t.getTime()+nextMin*60000).toISOString()}
    if(!o.nextDueAt)o.nextDueAt=new Date(Date.now()+step*60000).toISOString();
  }
  const btn=$("#saveBtn");btn.disabled=true;
  try{
    const now=new Date().toISOString();
    if(editingId){const prev=records.find(r=>r.id===editingId)||{};
      await col.doc(editingId).set({...o,createdAt:prev.createdAt||now,createdBy:prev.createdBy||me,updatedAt:now,updatedBy:me});
    }else{const ref=col.doc();await ref.set({...o,createdAt:now,createdBy:me});editingId=ref.id}
    if(o.status==="complete"){endEdit();setMsg(msg,"บันทึกครบแล้ว ("+o.pid+", "+o.date+") เริ่มรายการใหม่ได้เลย",true);window.scrollTo({top:0})}
    else{$("#editText").textContent="กำลังฟอก: "+o.pid+" · "+o.date;$("#editBanner").hidden=false;ensureDelete();
      setMsg(msg,"บันทึกแล้ว "+o.monitor.length+" จุดเวลา · กรอก Step 3 เมื่อคืนเลือด",true)}
  }catch(ex){const code=ex&&ex.code;
    const M={bad_key:"รหัสหน่วยไม่ถูกต้อง",unknown_pid:"รหัสวิจัยนี้ไม่อยู่ในทะเบียน กด “เปลี่ยนผู้ป่วย” แล้วแปลง HN ใหม่",
      need_initials:"ผู้ป่วยใหม่ต้องมีอักษรย่อ",looks_like_hn:"รหัสผู้ป่วยดูเหมือน HN กรุณาใช้รหัสวิจัย",bad_initials:"อักษรย่อห้ามมีตัวเลข",busy:"ระบบกำลังบันทึกของเครื่องอื่น ลองกดบันทึกอีกครั้ง"};
    setMsg(msg,M[code]||"บันทึกไม่สำเร็จ ตรวจอินเทอร์เน็ตแล้วลองอีกครั้ง",false);
  }finally{btn.disabled=false}
});

.dxg summary .dxn{margin-left:auto;font-size:12px;min-width:22px;height:22px;border-radius:999px;display:grid;place-items:center;background:var(--primary);color:var(--primary-ink)}
.dxlist{display:flex;flex-wrap:wrap;gap:6px;padding:2px 0 10px}
.dxp span{font-size:12.5px!important;padding:4px 11px!important}
#dxOther{font-family:var(--f-body);font-size:14px}
.autosum{border-radius:16px;background:var(--sunk);border:1.5px dashed var(--accent);padding:10px 12px}
.as-h{font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:6px}
.as-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}

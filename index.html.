.actpills{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.actpills .pill span{font-size:12.5px;padding:4px 12px}
.othertxt{flex:1 1 100%;font-family:var(--f-body)!important;font-size:13.5px!important;padding:7px 12px!important;border-radius:999px!important;background:var(--surface)!important}
.reftbl td b{font-family:var(--f-disp)}

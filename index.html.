.bedgrid input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.bedgrid span{display:block;text-align:center;padding:7px 0;border:1.5px solid var(--line);border-radius:10px;font-family:var(--f-mono);font-weight:600;background:var(--sunk)}

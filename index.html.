    const y=el("button","btn danger","ลบ");y.type="button";const n=el("button","btn","ไม่ลบ");n.type="button";n.onclick=ensureDelete;
    y.onclick=async()=>{try{await col.doc(editingId).delete();endEdit();setMsg($("#formMsg"),"ลบรายการแล้ว",true)}catch(ex){setMsg($("#formMsg"),"ลบไม่สำเร็จ",false)}};
    z.append(el("span",null,"ยืนยันลบรายการนี้? ลบแล้วกู้คืนไม่ได้"),y,n)};
  z.append(b);$("#saveBar").after(z);
}

function show(v){
  ["board","form","list","sum"].forEach(k=>{$("#view-"+k).hidden=k!==v});
  document.querySelectorAll(".tabbar button").forEach(b=>b.setAttribute("aria-selected",b.dataset.view===v?"true":"false"));

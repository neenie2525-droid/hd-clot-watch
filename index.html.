@keyframes pulse{50%{box-shadow:0 0 0 6px color-mix(in srgb,var(--r) 30%,transparent)}}
.gate{max-width:420px;margin:40px auto;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:var(--shadow)}
.gate h2{margin:0 0 6px;font-size:19px}
.soundbtn[aria-pressed="true"]{background:var(--g-soft);border-color:var(--g);color:var(--g)}
@media (max-width:520px){.step small{display:none}.step{padding:8px}.top h1{font-size:19px}}
.hico{display:inline-grid;place-items:center;flex:none;width:28px;height:28px;border-radius:9px;background:var(--primary-soft);color:var(--primary);vertical-align:-7px;margin-right:8px}

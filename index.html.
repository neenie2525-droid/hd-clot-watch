renderAll();

(async()=>{
  const status=$("#status");
  if(API_URL.startsWith("PASTE")){status.textContent="ยังไม่ได้ตั้งค่า API_URL ในไฟล์ index.html";status.className="status err";return}
  const tg=$("#alertToggle");
  tg.addEventListener("change",async()=>{const ak=$("#adminKey").value.trim();tg.disabled=true;
    try{await api("setAlerts",{adminKey:ak,alerts:tg.checked});alertsOn=tg.checked;applyAlerts();setMsg($("#alertMsg"),tg.checked?"เปิดการเตือนแล้ว":"ปิดการเตือนแล้ว",true)}
    catch(e){tg.checked=alertsOn;setMsg($("#alertMsg"),e.code==="bad_admin_key"?"รหัสผู้ดูแลไม่ถูกต้อง":"เปลี่ยนไม่สำเร็จ",false)}finally{tg.disabled=false}});
  async function load(full){
    try{const j=await api(full?"list":"active");
      alertsOn=j.alerts!==false;
      if(Array.isArray(j.patients))serverPts=j.patients;
      if(full)records=j.records;else{const ids=new Set(j.records.map(r=>r.id));records=j.records.concat(records.filter(r=>!ids.has(r.id)&&isDone(r)))}
      records.sort((x,y)=>String(y.createdAt||"").localeCompare(String(x.createdAt||"")));
      status.textContent="เชื่อมต่อแล้ว · อัปเดตล่าสุด "+new Date().toLocaleTimeString("th-TH",{hour:"2-digit",minute:"2-digit"});status.className="status ok";
      applyAlerts();renderAll();return true;
    }catch(e){
      if(e.code==="bad_key"){showGate();return false}
      status.textContent="เชื่อมต่อไม่ได้ ("+(e.code||e.message)+") จะลองใหม่อัตโนมัติ";status.className="status err";return false}
  }
  function showGate(){$("#gate").hidden=false;document.querySelectorAll("#view-board,#view-form,#view-list,#view-sum,nav.tabs").forEach(x=>x.hidden=true);status.textContent="ต้องใส่รหัสหน่วยก่อนใช้งาน";status.className="status err"}
  $("#gateBtn").addEventListener("click",async()=>{unitKey=$("#gateKey").value.trim();try{localStorage.setItem("hdcw-key",unitKey)}catch(e){}
    if(await load(true)){$("#gate").hidden=true;document.querySelector("nav.tabs").hidden=false;show("board")}else setMsg($("#gateMsg"),"รหัสไม่ถูกต้อง",false)});
  if(!unitKey){showGate();return}
  await load(true);
  setInterval(()=>{if(document.visibilityState==="visible")load(false)},20000);
  setInterval(()=>{if(document.visibilityState==="visible")load(true)},300000);
})();
})();

<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>HD Clot Watch · หน่วยไตเทียม</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mali:wght@500;600;700&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
/* Palette updated: pastel green ground, sage-green primary. Layout: one friendly working column. Form follows the unit's own guideline: SCREEN → MONITOR (TRIGGER/ACT in each time point) → EVALUATE.
   Palette: soft lavender ground, violet primary, the guideline's 4 status colours. Type: Mali (rounded display), Plex Sans Thai Looped (readable body), Plex Mono (numbers). */
:root{
  --bg:#eef7f1; --surface:#ffffff; --sunk:#f5fbf7; --line:#d3eadc; --ink:#1f3a2f; --muted:#5d7a6c;
  --primary:#2f8f68; --primary-ink:#ffffff; --primary-soft:#dcf2e5; --accent:#b8e3c9;
  --g:#1f9d6b; --g-soft:#dcf4e8; --y:#b98100; --y-soft:#fff2c9; --o:#dd6116; --o-soft:#ffe5d3; --r:#d42e48; --r-soft:#fde0e5;
  --shadow:0 1px 0 rgba(30,90,60,.06),0 6px 18px -10px rgba(30,90,60,.25);
  --f-disp:"Mali","IBM Plex Sans Thai Looped",system-ui,sans-serif;
  --f-body:"IBM Plex Sans Thai Looped",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#111d17; --surface:#1a2a22; --sunk:#15231c; --line:#2c4537; --ink:#e6f4ec; --muted:#9fbdad;
  --primary:#8fd9b1; --primary-ink:#10241a; --primary-soft:#22402f; --accent:#2f5a43;
  --g:#5fd3a0; --g-soft:#173528; --y:#f2c14e; --y-soft:#3a3016; --o:#ff9a5c; --o-soft:#3d2617; --r:#ff7a8e; --r-soft:#3f1d26;
  --shadow:0 1px 0 rgba(0,0,0,.3),0 8px 20px -12px rgba(0,0,0,.6); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#111d17; --surface:#1a2a22; --sunk:#15231c; --line:#2c4537; --ink:#e6f4ec; --muted:#9fbdad;
  --primary:#8fd9b1; --primary-ink:#10241a; --primary-soft:#22402f; --accent:#2f5a43;
  --g:#5fd3a0; --g-soft:#173528; --y:#f2c14e; --y-soft:#3a3016; --o:#ff9a5c; --o-soft:#3d2617; --r:#ff7a8e; --r-soft:#3f1d26;
  --shadow:0 1px 0 rgba(0,0,0,.3),0 8px 20px -12px rgba(0,0,0,.6); color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{padding-top:env(safe-area-inset-top,0px)}
body{margin:0}
img{max-width:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.6;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0 64px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.wrap{max-width:820px;margin:0 auto}
h1,h2,h3,.disp{font-family:var(--f-disp);font-weight:700;letter-spacing:0}
/* header */
.top{display:flex;gap:14px;align-items:center;padding-block:18px 10px}
.top svg{flex:none}
.top h1{font-size:22px;margin:0;line-height:1.25;text-wrap:balance}
.top p{margin:2px 0 0;color:var(--muted);font-size:13px}
/* tabs */
nav.tabs{position:sticky;top:env(safe-area-inset-top,0px);z-index:6;background:var(--bg);padding-block:8px 10px}
.tabbar{display:flex;gap:6px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:5px;box-shadow:var(--shadow)}
.tabbar button{flex:1;display:flex;gap:6px;align-items:center;justify-content:center;font:inherit;font-family:var(--f-disp);font-weight:600;font-size:15px;border:0;background:none;color:var(--muted);padding:8px 6px;border-radius:999px;cursor:pointer}
.tabbar button svg{width:18px;height:18px}
.tabbar button[aria-selected="true"]{background:var(--primary);color:var(--primary-ink)}
.statusrow{display:flex;gap:8px 12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin:2px 4px 10px}
.statusrow .status{margin:0}
.who-chip{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--muted);font-weight:600}
.who-chip select{width:190px;max-width:52vw;padding:4px 10px;font-size:13px;border:1.5px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink)}
.who-chip.need select{border-color:var(--o);background:var(--o-soft)}
.who-chip input[type=text]{width:150px;padding:4px 10px;font-size:13px;font-family:var(--f-body);border-radius:999px;background:var(--surface)}
.who-chip.need input{border-color:var(--o);background:var(--o-soft)}
.status{font-size:12.5px;color:var(--muted);margin:2px 4px 10px;display:flex;gap:6px;align-items:center}
.status::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--y)}
.status.ok::before{background:var(--g)} .status.err{color:var(--r)} .status.err::before{background:var(--r)}
/* step nav */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.step{display:flex;gap:8px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:8px 10px;cursor:pointer;font:inherit;color:var(--ink);text-align:left;min-width:0}
.step .ic{flex:none;width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary)}
.step .ic svg{width:18px;height:18px}
.step b{display:block;font-family:var(--f-disp);font-size:13.5px;line-height:1.2}
.step small{display:block;color:var(--muted);font-size:11.5px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.step.done .ic{background:var(--g-soft);color:var(--g)}
/* cards */
.card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:18px;margin-bottom:16px;box-shadow:var(--shadow);scroll-margin-top:80px}
.card-h{display:flex;gap:12px;align-items:center;margin-bottom:14px}
.card-h .ic{flex:none;width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary)}
.card-h .ic svg{width:22px;height:22px}
.card-h h2{font-size:18px;margin:0;line-height:1.25}
.card-h p{margin:0;color:var(--muted);font-size:12.5px}
.tag{font-family:var(--f-mono);font-size:11px;font-weight:600;letter-spacing:.06em;color:var(--primary);text-transform:uppercase}
.sub{font-family:var(--f-disp);font-size:14.5px;margin:18px 0 10px;color:var(--ink);display:flex;align-items:center;gap:8px}
.sub::after{content:"";flex:1;height:1px;background:var(--line)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}
.field{display:flex;flex-direction:column;gap:5px;min-width:0}
.field.wide{grid-column:1/-1}
.field label,.field .lbl{font-size:13px;font-weight:600}
.q{display:inline-block;min-width:20px;font-family:var(--f-mono);font-size:10.5px;color:var(--muted);margin-right:2px}
.new{font-size:10.5px;color:var(--primary);background:var(--primary-soft);border-radius:999px;padding:0 7px;margin-left:6px;font-weight:600;vertical-align:1px}
.hint{font-size:12px;color:var(--muted)}
input[type=text],input[type=number],input[type=date],input[type=time],select{font:inherit;font-family:var(--f-mono);font-size:15px;padding:9px 12px;border:1.5px solid var(--line);border-radius:12px;background:var(--sunk);color:var(--ink);width:100%}
select{font-family:var(--f-body);font-size:14px}
input:focus-visible,select:focus-visible,button:focus-visible,.seg label:focus-within,.pill:focus-within,.gcard:focus-within{outline:2.5px solid var(--primary);outline-offset:2px}
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg label,.pill{position:relative;cursor:pointer}
.seg input,.pill input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.seg span,.pill span{display:inline-block;padding:6px 14px;border:1.5px solid var(--line);border-radius:999px;font-size:13.5px;background:var(--sunk);transition:background .12s,border-color .12s}
.seg input:checked+span{background:var(--primary-soft);border-color:var(--primary);color:var(--ink);font-weight:600}
.pill input:checked+span{background:var(--primary);border-color:var(--primary);color:var(--primary-ink);font-weight:600}
.pill.warn input:checked+span{background:var(--r-soft);border-color:var(--r);color:var(--r)}
.risk{margin-top:14px;padding:12px 14px;border-radius:14px;background:var(--sunk);border:1.5px dashed var(--line);font-size:13px}
.risk b{font-family:var(--f-disp)}
.risk .chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.rchip{background:var(--o-soft);color:var(--o);border-radius:999px;padding:2px 10px;font-size:12.5px;font-weight:600}
/* monitor */
.now{display:flex;gap:14px;align-items:center;border-radius:16px;padding:12px 14px;margin-bottom:14px;background:var(--sunk);border:1.5px solid var(--line)}
.now .big{font-family:var(--f-disp);font-size:20px;line-height:1.2}
.now .sm{font-size:12.5px;color:var(--muted)}
.now .lamp{flex:none;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--line)}
.now .lamp svg{width:24px;height:24px}
.now.l0{background:var(--g-soft);border-color:var(--g)} .now.l0 .lamp{background:var(--g);color:var(--surface)}
.now.l1{background:var(--y-soft);border-color:var(--y)} .now.l1 .lamp{background:var(--y);color:var(--surface)}
.now.l2{background:var(--o-soft);border-color:var(--o)} .now.l2 .lamp{background:var(--o);color:var(--surface)}
.now.l3{background:var(--r-soft);border-color:var(--r)} .now.l3 .lamp{background:var(--r);color:var(--surface)}
details.ref{border:1.5px solid var(--line);border-radius:14px;padding:4px 12px;margin-bottom:14px;background:var(--sunk)}
details.ref summary{cursor:pointer;font-family:var(--f-disp);font-weight:600;font-size:14px;padding:6px 0}
.reftbl{overflow-x:auto;margin:6px 0 10px}
.reftbl table{border-collapse:separate;border-spacing:4px;width:100%;min-width:520px;font-size:12.5px}
.reftbl th{font-family:var(--f-disp);padding:6px;border-radius:8px;color:var(--surface)}
.reftbl td{padding:6px 8px;border-radius:8px;background:var(--surface);vertical-align:top}
.reftbl td:first-child{font-weight:600;background:none}
.c0{background:var(--g)} .c1{background:var(--y)} .c2{background:var(--o)} .c3{background:var(--r)}
.timeline{display:flex;flex-direction:column;gap:0}
.pt{display:grid;grid-template-columns:28px 1fr;gap:10px}
.pt-rail{display:flex;flex-direction:column;align-items:center}
.pt-dot{width:18px;height:18px;border-radius:50%;background:var(--surface);border:4px solid var(--line);margin-top:18px;flex:none}
.pt-line{flex:1;width:3px;background:var(--line);border-radius:2px;margin-top:2px}
.pt:last-child .pt-line{background:transparent}
.pt-body{background:var(--sunk);border:1.5px solid var(--line);border-radius:16px;padding:12px;margin-bottom:12px;min-width:0}
.pt.l0 .pt-dot{border-color:var(--g)} .pt.l1 .pt-dot{border-color:var(--y)} .pt.l2 .pt-dot{border-color:var(--o)} .pt.l3 .pt-dot{border-color:var(--r);background:var(--r)}
.pt.l1 .pt-body{border-color:var(--y)} .pt.l2 .pt-body{border-color:var(--o)} .pt.l3 .pt-body{border-color:var(--r);border-width:2px}
.pt-head{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.minbox{display:flex;align-items:center;gap:8px 10px;flex-wrap:wrap;font-family:var(--f-disp);font-weight:600;flex:1 1 100%}
.elapsed{display:flex;align-items:center;gap:6px}
.elapsed .ell{font-size:14px}
.elapsed input{width:66px!important;min-width:0!important;padding-left:8px!important;padding-right:8px!important;text-align:center}
.elapsed .u{font-family:var(--f-body);font-weight:500;font-size:13px;color:var(--muted)}
.esrc{flex:1 1 100%;font-family:var(--f-body);font-weight:500;font-size:12.5px;color:var(--muted);margin-top:-2px}
.esrc.warn{color:var(--o);font-weight:600}
.minbox input{width:76px;padding:5px 8px;font-size:15px;text-align:center}
.minbox input[type=time]{width:auto;min-width:112px;padding:6px 10px;font-size:16px;text-align:center;background:var(--surface)}
.mincalc{font-family:var(--f-body);font-weight:500;font-size:13px;color:var(--muted)}
.mincalc.warn{color:var(--o);font-weight:600}
.lvbadge{font-family:var(--f-disp);font-size:13px;font-weight:600;padding:2px 12px;border-radius:999px;background:var(--line);color:var(--ink)}
.l0 .lvbadge{background:var(--g-soft);color:var(--g)} .l1 .lvbadge{background:var(--y-soft);color:var(--y)} .l2 .lvbadge{background:var(--o-soft);color:var(--o)} .l3 .lvbadge{background:var(--r);color:var(--surface)}
.delta{font-family:var(--f-mono);font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums}
.delta b{color:var(--ink);font-weight:600}
.rm{margin-left:auto;font:inherit;font-size:12.5px;border:0;background:none;color:var(--muted);cursor:pointer;padding:4px 6px;border-radius:8px}
.rm:hover{color:var(--r)}
.pt-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(104px,1fr));gap:8px}
.pt-grid .field label{font-size:11.5px;color:var(--muted)}
.pt-grid input,.pt-grid select{padding:7px 9px;background:var(--surface)}
.flags{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.flags .pill span{font-size:12.5px;padding:4px 12px}
.eval{margin-top:10px;border-radius:12px;padding:10px 12px;font-size:13px;background:var(--g-soft)}
.l1 .eval{background:var(--y-soft)} .l2 .eval{background:var(--o-soft)} .l3 .eval{background:var(--r-soft)}
.eval .plan{font-weight:500}
#f-dx{font-family:var(--f-body)}
body.typing .savebar{position:static;box-shadow:none}
.pidshow{display:flex;align-items:center;gap:8px 12px;flex-wrap:wrap;padding:10px 14px;border-radius:18px;background:var(--primary-soft);border:1.5px solid var(--accent)}
.pidtag{font-family:var(--f-disp);font-weight:600}
.pidtag b{font-family:var(--f-mono);font-size:18px;color:var(--primary);margin-left:4px}
.pidnote{font-size:12.5px;color:var(--muted);flex:1 1 100%;order:3}
.pidshow .linkbtn{margin-left:auto}
.linkbtn{font:inherit;font-size:13px;border:0;background:none;color:var(--primary);text-decoration:underline;cursor:pointer;padding:2px}
#f-hn{font-size:17px;letter-spacing:.04em}
.cmp{font-size:13.5px;font-weight:600;padding:8px 12px;border-radius:12px;background:var(--surface)}
.cmp.ok{color:var(--g)} .cmp.short{color:var(--o);background:var(--o-soft)}
#endCard .elapsed{margin-top:2px}
.dxsel[hidden]{display:none!important}
.dxsel{display:flex;flex-wrap:wrap;gap:6px;padding:8px 10px;border-radius:14px;border:1.5px dashed var(--line);min-height:42px;align-items:center}
.dxchip{font:inherit;font-size:12.5px;font-weight:600;border:0;border-radius:999px;padding:3px 10px;background:var(--primary);color:var(--primary-ink);cursor:pointer}
.dxchip.o{background:var(--accent);color:var(--ink)}
.dxwrap{position:relative}
.dxsug{position:absolute;left:0;right:0;top:calc(100% + 4px);z-index:8;background:var(--surface);border:1.5px solid var(--accent);border-radius:16px;box-shadow:0 12px 28px -12px rgba(20,70,45,.45);overflow:hidden;max-height:330px;overflow-y:auto}
.dxopt{display:flex;flex-direction:column;align-items:flex-start;gap:0;width:100%;text-align:left;font:inherit;border:0;border-bottom:1px solid var(--line);background:none;color:var(--ink);padding:9px 14px;cursor:pointer}
.dxopt:last-child{border-bottom:0}
.dxopt.act,.dxopt:hover{background:var(--primary-soft)}
.dxopt .dxt{font-weight:600;font-size:14px}
.dxopt .dxg2{font-size:11.5px;color:var(--muted)}
.dxnone{padding:10px 14px;font-size:13px;color:var(--muted)}
.dxcount{font-size:12px;color:var(--primary);margin-left:6px}
#dxSearch{font:inherit;font-family:var(--f-body);font-size:14px;padding:9px 14px;border:1.5px solid var(--line);border-radius:999px;background:var(--sunk);color:var(--ink);width:100%;-webkit-appearance:none;appearance:none}
.dxgroups{display:flex;flex-direction:column;gap:6px;padding-bottom:8px}
.dxqh{font-size:12.5px;font-weight:600;color:var(--muted);margin-top:2px}
.dxall{border-radius:14px}
.dxall>summary{cursor:pointer;font-family:var(--f-disp);font-weight:600;font-size:13.5px;color:var(--primary);padding:6px 2px}
.dxg{border:1.5px solid var(--line);border-radius:14px;background:var(--sunk);padding:2px 12px}

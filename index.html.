.sc-l{font-family:var(--f-disp);font-weight:700;font-size:15px}
.sc-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.sc-row input{width:auto!important;min-width:130px;font-size:17px!important;text-align:center;background:var(--surface)!important}
.sc-row .btn{padding:8px 14px}
.triglbl{margin-top:10px;font-size:12px;font-weight:600;color:var(--muted)}
.trig{display:flex;flex-wrap:wrap;gap:5px;margin-top:4px}

function actUI(o){
  const a=o.actualMin,rx=o.rxHours,src=$("#actSrc"),cmp=$("#actCmp");
  src.textContent=a==null?"ลงเวลาเลิก แอพคำนวณเวลาฟอกจริงให้ หรือกรอก ชม./นาที จากหน้าจอเครื่อง":(actManual?"✍️ กรอกจากหน้าจอเครื่อง":"⏱️ คำนวณจากเวลาเริ่ม "+(o.startTime||"–")+" ถึงเวลาเลิก "+(o.endTime||"–")+" (แก้ได้)");

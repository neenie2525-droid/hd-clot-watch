.board-h h2{font-size:18px;margin:0;flex:1}
.bgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;margin-bottom:18px}
.bed{position:relative;text-align:left;font:inherit;color:var(--ink);background:var(--surface);border:2px solid var(--line);border-radius:16px;padding:10px 12px;min-height:104px;cursor:pointer;box-shadow:var(--shadow)}
.bed.free{background:var(--sunk);box-shadow:none;cursor:default;color:var(--muted)}
.bed .no{font-family:var(--f-disp);font-weight:700;font-size:17px}
.bed .who{font-family:var(--f-mono);font-size:13px}
.bed .st{font-size:12.5px;margin-top:4px}
.bed .due{font-size:12px;color:var(--muted);margin-top:2px}
.bed.l0{border-color:var(--g)} .bed.l1{border-color:var(--y);background:var(--y-soft)} .bed.l2{border-color:var(--o);background:var(--o-soft)} .bed.l3{border-color:var(--r);background:var(--r-soft)}
.bed.over .due{color:var(--r);font-weight:700}
.bed.over{outline:3px solid var(--r);outline-offset:1px}

// รายการที่พบบ่อยในหน่วย (ผู้ป่วยวิกฤต) แสดงไว้ให้แตะได้ทันที
const DX_QUICK=["Sepsis","Septic shock","Pneumonia (HAP/VAP/CAP)","UTI/Pyelonephritis","CRBSI","DLC/Perm cath malfunction","Volume overload","Hyperkalemia","Metabolic acidosis","Uremia/Uremic symptoms","AKI on top CKD","CHF","Cardiogenic shock","Post cardiac arrest","Bleeding","DM","HT"];
const DX_ALL=[];DX_GROUPS.forEach(([g,,items])=>items.forEach(t=>DX_ALL.push({g,t})));
let dxPicked=new Set(),dxLastHidden=null;
function dxSet(t,on){on?dxPicked.add(t):dxPicked.delete(t);dxToHidden()}
function dxToHidden(){
  const other=$("#dxOther").value.trim();
  const list=DX_ALL.filter(x=>dxPicked.has(x.t)).map(x=>x.t);other.split(/\s*,\s*/).filter(Boolean).forEach(t=>list.push("อื่น ๆ: "+t));
  form.elements.dxText.value=list.join("; ");
  form.elements.dxGroups.value=[...new Set(DX_ALL.filter(x=>dxPicked.has(x.t)).map(x=>x.g).concat(other?["other"]:[]))].join(";");
  dxLastHidden=form.elements.dxText.value;dxRenderSel();
}
function dxFromHidden(){
  const v=form.elements.dxText.value||"";if(v===dxLastHidden)return;dxLastHidden=v;
  dxPicked=new Set();const others=[];
  v.split(/;\s*/).map(x=>x.trim()).filter(Boolean).forEach(t=>{
    const o=/^อื่น ๆ:\s*/.test(t)?null:DX_ALL.find(x=>x.t.toLowerCase()===t.toLowerCase());
    if(o)dxPicked.add(o.t);else others.push(t.replace(/^อื่น ๆ:\s*/,""))});
  $("#dxOther").value=others.join(", ");
  form.elements.dxGroups.value=[...new Set(DX_ALL.filter(x=>dxPicked.has(x.t)).map(x=>x.g).concat(others.length?["other"]:[]))].join(";");
  dxRenderSel();
}
function dxRenderSel(){
  const box=$("#dxSel");box.textContent="";const other=$("#dxOther").value.trim();
  const items=DX_ALL.filter(x=>dxPicked.has(x.t));
  if(!items.length&&!other){box.hidden=true}else box.hidden=false;
  items.forEach(x=>{const c=el("button","dxchip",x.t+" ✕");c.type="button";c.title="เอาออก";
    c.addEventListener("click",()=>dxSet(x.t,false));box.append(c)});
  const olist=other?other.split(/\s*,\s*/).filter(Boolean):[];
  olist.forEach(t=>{const c=el("button","dxchip o",t+" ✕");c.type="button";c.title="เอาออก";c.addEventListener("click",()=>window.dxRemoveOther(t));box.append(c)});
  const n=items.length+olist.length;$("#dxCount").textContent=n?"เลือกแล้ว "+n:"";
}
(function(){
  const inp=$("#dxSearch"),sug=$("#dxSug");let hits=[],act=0;
  const norm=t=>t.toLowerCase().replace(/[\s/().\-]+/g," ");
  const GL=Object.fromEntries(DX_GROUPS.map(([g,l])=>[g,l]));
  function others(){return $("#dxOther").value.split(/\s*,\s*/).filter(Boolean)}
  function setOthers(a){$("#dxOther").value=a.join(", ");dxToHidden()}
  function close(){sug.hidden=true;inp.setAttribute("aria-expanded","false")}
  function pick(i){const h=hits[i];if(!h)return;
    if(h.custom){const o=others();if(!o.includes(h.t))o.push(h.t);setOthers(o)}else dxSet(h.t,true);
    inp.value="";close();inp.focus()}
  function show(){
    const q=norm(inp.value.trim());sug.textContent="";hits=[];act=0;
    if(!q){close();return}
    const words=q.split(" ").filter(Boolean);
    const scored=DX_ALL.filter(x=>!dxPicked.has(x.t)).map(x=>{const n=norm(x.t);if(!words.every(w=>n.includes(w)))return null;
      return {...x,s:(n.startsWith(q)?0:n.split(" ").some(w=>w.startsWith(words[0]))?1:2)}}).filter(Boolean)
      .sort((a,b)=>a.s-b.s||a.t.length-b.t.length).slice(0,8);
    hits=scored;
    const raw=inp.value.trim();
    if(!hits.length&&raw.length>=2&&!DX_ALL.some(x=>x.t.toLowerCase()===raw.toLowerCase()))hits.push({t:raw,custom:true});
    hits.forEach((h,i)=>{const b=el("button","dxopt"+(i===0?" act":""));b.type="button";b.setAttribute("role","option");
      if(h.custom){b.append(el("span","dxt","➕ เพิ่ม “"+h.t+"”"),el("span","dxg2","อื่น ๆ (ไม่มีในรายการ)"))}
      else{b.append(el("span","dxt",h.t),el("span","dxg2",GL[h.g]))}
      b.addEventListener("mousedown",e=>e.preventDefault());b.addEventListener("click",()=>pick(i));sug.append(b)});
    if(!hits.length)sug.append(el("div","dxnone","ไม่พบ ลองพิมพ์คำอื่น"));
    sug.hidden=false;inp.setAttribute("aria-expanded","true");
  }
  function mark(){sug.querySelectorAll(".dxopt").forEach((b,i)=>b.classList.toggle("act",i===act))}
  inp.addEventListener("input",e=>{e.stopPropagation();show()});
  inp.addEventListener("keydown",e=>{
    if(e.key==="Enter"){e.preventDefault();pick(act)}
    else if(e.key==="ArrowDown"&&hits.length){e.preventDefault();act=(act+1)%hits.length;mark()}
    else if(e.key==="ArrowUp"&&hits.length){e.preventDefault();act=(act-1+hits.length)%hits.length;mark()}
    else if(e.key==="Escape"){close()}});
  inp.addEventListener("blur",()=>setTimeout(close,150));
  inp.addEventListener("focus",show);
  window.dxRemoveOther=t=>setOthers(others().filter(x=>x!==t));
  dxRenderSel();
})();


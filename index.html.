function evaluate(p){
  const bfrSet=num(form.elements.bfrSet.value);
  const t=[];const {dtmp}=deltas(p);
  if(bfrSet&&p.bfr!=null&&p.bfr<bfrSet*0.9)t.push("EFF BFR ลดลง > 10% ของ BFR ที่ตั้ง");
  const ref=(p.bfr??bfrSet);const half=ref?ref/2:null;
  const lo=half!=null?Math.max(0,Math.round(half-50)):null,hi=half!=null?Math.round(half+50):null;
  if(half!=null&&p.vp!=null&&Math.abs(p.vp-half)>50)t.push("VP ผิดปกติ: "+p.vp+" (ควรอยู่ "+lo+"–"+hi+")");
  if(dtmp!=null&&dtmp>=40)t.push("TMP เพิ่มขึ้น "+dtmp+" จากจุดแรก (≥ 40)");
  const seq=byMin();const i=seq.indexOf(p);
  if(i>=2){const up=k=>seq[i-2][k]!=null&&seq[i-1][k]!=null&&p[k]!=null&&seq[i-2][k]<seq[i-1][k]&&seq[i-1][k]<p[k];
    if(up("vp")||up("tmp"))t.push("VP/TMP เพิ่มขึ้นต่อเนื่อง")}
  if(p.alarm)t.push("Pressure alarm เกิดซ้ำ");
  if((p.clot||0)>=1)t.push("พบ fibrin หรือ clot ในสายเลือด/ตัวกรอง");
  if(p.pump)t.push("Blood pump interruption");
  if(p.acBad)t.push("Anticoagulation therapy ไม่เป็นไปตามแผน");
  if(p.otherTrig&&p.otherTrig.trim())t.push("อื่น ๆ: "+p.otherTrig.trim());
  const vpL=p.vp==null?0:p.vp>210?3:p.vp>180?2:p.vp>150?1:0;
  const tmL=dtmp==null?0:dtmp>120?3:dtmp>80?2:dtmp>=40?1:0;
  return {level:Math.max(vpL,tmL,Number(p.clot)||0),triggers:t};
}

function renderList(){
  const q=$("#search").value.trim().toLowerCase();
  const box=$("#rows");box.textContent="";
  const list=records.filter(r=>!q||(String(r.pid||"")+" "+String(r.pinit||"")).toLowerCase().includes(q));
  const em=$("#listEmpty");em.hidden=list.length>0;
  em.textContent=records.length?"ไม่พบรหัสที่ค้นหา":"ยังไม่มีข้อมูล เริ่มบันทึกได้ที่แท็บ “บันทึก” รายการแต่ละครั้งที่ฟอกจะแสดงที่นี่";
  list.forEach(r=>{
    const b=el("button","rec");b.type="button";
    const lv=Number(r.maxLevel)||0;
    b.append(el("span","dot"+(alertsOn&&(r.monitor||[]).length?" l"+lv:"")));
    const mid=el("span");mid.append(el("span","pid",(r.pid||"–")+(r.pinit?" · "+r.pinit:"")));
    mid.append(el("div","meta",[r.date,r.locType==="portable"?("Portable "+(r.slot||"")+(r.pward?" "+r.pward:"")):(r.bed?"เตียง "+r.bed:null),LABEL.shift[r.shift],LABEL.ward[r.ward],LABEL.access[r.access],LABEL.anticoag[r.anticoag]].filter(Boolean).join(" · ")));
    b.append(mid);
    const right=el("span");right.style.display="flex";right.style.gap="6px";right.style.flexWrap="wrap";right.style.justifyContent="flex-end";
    if(isDone(r)){right.append(el("span","chip g"+r.grade,"Grade "+r.grade));if(isClot(r))right.append(el("span","chip clot","อุดตัน"))}
    else right.append(el("span","chip on","กำลังฟอก · "+(r.monitor||[]).length+" จุด"+(alertsOn&&lv?" · "+LV[lv].s:"")));
    b.append(right);
    b.addEventListener("click",()=>startEdit(r.id));
    box.append(b);
  });
  $("#countBadge").textContent=records.length?"("+records.length+")":"";
}
$("#search").addEventListener("input",renderList);

function renderSum(){
  const done=records.filter(isDone);
  const n=done.length,ev=done.filter(isClot).length;
  $("#k-n").textContent=n.toLocaleString();
  $("#k-pt").textContent=new Set(done.map(r=>r.pid)).size.toLocaleString();
  $("#k-ev").textContent=ev.toLocaleString();
  $("#k-rate").textContent=n?(ev/n*100).toFixed(2):"–";
  const pr=Math.min(100,Math.round(n/1030*100));$("#k-target").textContent=pr+"%";$("#k-prog").style.width=pr+"%";
  $("#k-mon").textContent=n?Math.round(done.filter(r=>(r.monitor||[]).length>=2).length/n*100)+"%":"–";
  const gc=[0,0,0,0];done.forEach(r=>{const g=Number(r.grade);if(g>=0&&g<=3)gc[g]++});
  const gb=$("#gbar"),gl=$("#glegend");gb.textContent="";gl.textContent="";
  const cols=["var(--g)","var(--y)","var(--o)","var(--r)"];
  gc.forEach((c,i)=>{if(n&&c){const s=el("i");s.style.width=(c/n*100)+"%";s.style.background=cols[i];s.title="Grade "+i+": "+c;gb.append(s)}
    const lg=el("span",null,"Grade "+i+" · "+c+(n?" ("+Math.round(c/n*100)+"%)":""));lg.style.setProperty("--c",cols[i]);gl.append(lg)});
  const tb=$("#factorRows");tb.textContent="";
  const groups=[
    ["Dx ภาวะไต","renalDx"],["ใส่ ETT","ett"],["เคยอุดตันครั้งก่อน","prevClot"],["Access","access"],["เครื่อง","machine"],["ยาต้านการแข็งตัว","anticoag"],["ให้เลือดผ่านวงจร","transfusion"],
    ["Hct","hctG",r=>r.hct==null?null:(r.hct>=30?"≥ 30%":"< 30%")],
    ["เกล็ดเลือด","pltG",r=>r.plt==null?null:(r.plt<100?"< 100":"≥ 100")],
    ["ระดับสีสูงสุดระหว่างฟอก","lvG",r=>(r.monitor||[]).length?LV[Number(r.maxLevel)||0].s:null]
  ];
  groups.forEach(([title,key,fn])=>{
    const m=new Map();
    done.forEach(r=>{const v=fn?fn(r):(r[key]==null?null:(LABEL[key]?.[r[key]]||r[key]));if(v==null)return;const a=m.get(v)||[0,0];a[0]++;if(isClot(r))a[1]++;m.set(v,a)});
    let first=true;if(!m.size)m.set("ยังไม่มีข้อมูล",null);
    m.forEach((a,label)=>{
      const tr=el("tr");const t=el("td",null,first?title:"");t.style.fontWeight="600";first=false;
      const c3=el("td","num",a?a[0]:"–"),c4=el("td","num",a?a[1]:"–"),c5=el("td","num",a&&a[0]?(a[1]/a[0]*100).toFixed(1):"–");
      tr.append(t,el("td",null,label),c3,c4,c5);tb.append(tr);
    });
  });
}

function csvCell(v){if(v==null)return "";const s=String(v);return /[",\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s}
async function saveCsv(name,lines){
  const msg=$("#csvMsg");const text="﻿"+lines.join("\r\n");
  const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([text],{type:"text/csv"}));a.download=name+"-"+today()+".csv";document.body.append(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(a.href),5000);setMsg(msg,"ดาวน์โหลดแล้ว",true)
}
const sortedRecs=()=>[...records].sort((a,b)=>String(a.date).localeCompare(String(b.date)));
$("#csvBtn").addEventListener("click",()=>{
  if(!records.length){setMsg($("#csvMsg"),"ยังไม่มีข้อมูลให้ส่งออก",false);return}
  const cols=["session_id","status","n_points"].concat(COLS);
  const lines=[cols.join(",")].concat(sortedRecs().map(r=>cols.map(k=>csvCell(k==="session_id"?r.id:k==="n_points"?(r.monitor||[]).length:k==="status"?(isDone(r)?"complete":"ongoing"):k==="clot"?(isClot(r)?1:0):r[k])).join(",")));
  saveCsv("circuit-clotting-eCRF",lines);
});
$("#csvMonBtn").addEventListener("click",()=>{
  const cols=["session_id","pid","date","minute","bfr","vp","tmp","d_vp","d_tmp","alarm_repeat","pump_interrupt","anticoag_not_as_planned","clot_grade_point","level","n_triggers","triggers","actions","session_clot"];
  const lines=[cols.join(",")];
  sortedRecs().forEach(r=>{
    const pts=(r.monitor||[]).slice().sort((a,b)=>(a.min??0)-(b.min??0));const b=pts.find(p=>p.vp!=null||p.tmp!=null);
    pts.forEach(p=>{const dvp=(b&&p.vp!=null&&b.vp!=null)?p.vp-b.vp:null,dtmp=(b&&p.tmp!=null&&b.tmp!=null)?p.tmp-b.tmp:null;
      lines.push([r.id,r.pid,r.date,p.min,p.bfr,p.vp,p.tmp,dvp,dtmp,p.alarm?1:0,p.pump?1:0,p.acBad?1:0,p.clot??"",p.level??"",(p.triggers||[]).length,(p.triggers||[]).join("; "),(p.actions||[]).join("; "),isDone(r)?(isClot(r)?1:0):""].map(csvCell).join(","))});
  });
  if(lines.length<2){setMsg($("#csvMsg"),"ยังไม่มีค่าตามเวลาให้ส่งออก",false);return}
  saveCsv("circuit-clotting-monitoring",lines);
});

function applyAlerts(){$("#alertNote").textContent=alertsOn?"":"· ขณะนี้ปิดการเตือน (แสดงเฉพาะ ΔVP/ΔTMP)";$("#alertToggle").checked=alertsOn;updateDeltas();renderList()}
function renderAll(){renderList();renderSum();renderBoard();renderPidOptions();ptUI()}
// ---------- board ----------
let boardShift=((d=>d.getHours()*60+d.getMinutes()>=930)(new Date())?"r3":"r1");
OPTS.shift.forEach(([v,t])=>{const l=el("label");const i=el("input");i.type="radio";i.name="boardShift";i.value=v;i.checked=v===boardShift;i.addEventListener("change",()=>{boardShift=v;renderBoard()});l.append(i,el("span",null,t));$("#shiftPick").append(l)});
let soundOn=false,actx=null,alerted=new Set();
$("#soundBtn").addEventListener("click",()=>{soundOn=!soundOn;$("#soundBtn").setAttribute("aria-pressed",soundOn?"true":"false");$("#soundBtn").textContent=soundOn?"เสียงเตือนเปิดอยู่":"เปิดเสียงเตือน";
  if(soundOn){try{actx=actx||new (window.AudioContext||window.webkitAudioContext)();actx.resume();beep(1)}catch(e){}}});
function beep(n){if(!soundOn||!actx)return;for(let k=0;k<n;k++){const o=actx.createOscillator(),g=actx.createGain();o.type="sine";o.frequency.value=880;const t=actx.currentTime+k*0.35;g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(0.3,t+0.02);g.gain.exponentialRampToValueAtTime(0.0001,t+0.25);o.connect(g).connect(actx.destination);o.start(t);o.stop(t+0.3)}}
function dueText(r){if(!r.nextDueAt)return r.lastLevel===3?"คืนเลือดตาม protocol":"";const m=Math.round((new Date(r.nextDueAt)-Date.now())/60000);return m>=0?"ประเมินถัดไปอีก "+m+" นาที":"เลยเวลาประเมิน "+(-m)+" นาที"}
function bedCard(label,r){
  const b=el("button","bed");b.type="button";
  b.append(el("div","no",label));
  if(!r){b.classList.add("free");b.append(el("div","st","ว่าง"));b.disabled=true;return b}
  const lv=r.lastLevel;const over=r.nextDueAt&&new Date(r.nextDueAt)<Date.now();
  if(alertsOn&&lv!=null)b.classList.add("l"+lv);if(alertsOn&&over)b.classList.add("over");
  b.append(el("div","who",(r.pid||"")+(r.pinit?" · "+r.pinit:"")));
  b.append(el("div","st",(r.lastMin!=null?"นาทีที่ "+r.lastMin+" · ":"ยังไม่มีจุดเวลา · ")+(alertsOn&&lv!=null?LV[lv].s:"")));
  if(alertsOn)b.append(el("div","due",dueText(r)));
  b.addEventListener("click",()=>startEdit(r.id));
  const k=r.id+":"+(r.lastMin??"")+":"+lv+":"+(over?"o":"");
  if(alertsOn&&(lv>=2||over)&&!alerted.has(k)){alerted.add(k);beep(lv===3||over?3:2)}
  return b;
}
function renderBoard(){
  const ug=$("#unitGrid"),pg=$("#portGrid");if(!ug)return;ug.textContent="";pg.textContent="";
  const live=records.filter(r=>!isDone(r));
  for(let b=1;b<=UNIT_BEDS;b++){const r=live.find(x=>x.locType!=="portable"&&Number(x.bed)===b);ug.append(bedCard("เตียง "+b,r))}
  for(let p=1;p<=PORT_SLOTS;p++){const r=live.find(x=>x.locType==="portable"&&x.slot==="P"+p&&(x.shift||"r1")===boardShift);pg.append(bedCard("P"+p+(r&&r.pward?" · "+r.pward:""),r))}
}
